// FreeFEM Script for Cantilever Beam Validation
// Problem: Cantilever beam with distributed load and intermediate support
// Geometry: L = 1.0 m, h = 0.05 m (rectangular cross-section)
// Material: E = 210 GPa, ν = 0.3 (steel)
// Load: q = 1000 N/m distributed along top edge
// Boundary: Fixed at x=0, intermediate support at x=support_pos

// Parameters
// Note: This script will be generated by Julia wrapper with supportPos value
real L = 1.0;           // Beam length (m)
real h = 0.05;          // Beam height (m)
real supportPos = 0.5;  // Will be replaced by Julia wrapper
real E = 210e9;         // Young's modulus (Pa)
real nu = 0.3;          // Poisson's ratio
real q = 1000.0;        // Distributed load (N/m)

// Create mesh: rectangle [0,L] x [0,h]
border bottom(t=0, L) { x=t; y=0; label=1; }
border right(t=0, h) { x=L; y=t; label=2; }
border top(t=L, 0) { x=t; y=h; label=3; }
border left(t=h, 0) { x=0; y=t; label=4; }

// Mesh with appropriate refinement
int nx = 50;  // Number of elements along length
int ny = 5;   // Number of elements along height
mesh Th = buildmesh(bottom(nx) + right(ny) + top(nx) + left(ny));

// Define finite element spaces
fespace Vh(Th, [P1, P1]);  // Vectorial space for displacement
fespace Ph(Th, P1);         // Scalar space for stress components
Vh [u, v];  // Displacement components
Vh [u0, v0]; // Test functions

// Material properties (plane stress)
real lambda = E * nu / ((1 + nu) * (1 - nu));
real mu = E / (2 * (1 + nu));

// Intermediate support penalty parameters
real supportTolerance = L / nx;  // Tolerance for finding support point
real penalty = 1e12;

// Strain-displacement relations
macro epsilon(u, v) [dx(u), dy(v), (dy(u) + dx(v))] // EOM

// Stress-strain relation (plane stress)
macro sigma(u, v) [
    lambda * (dx(u) + dy(v)) + 2 * mu * dx(u),
    lambda * (dx(u) + dy(v)) + 2 * mu * dy(v),
    mu * (dy(u) + dx(v))
] // EOM

// Variational form: ∫ σ:ε dV = ∫ f·u dS
// Add penalty term for intermediate support
problem elasticity([u, v], [u0, v0]) =
    int2d(Th)(
        lambda * (dx(u) + dy(v)) * (dx(u0) + dy(v0)) +
        2 * mu * (dx(u) * dx(u0) + dy(v) * dy(v0)) +
        mu * (dy(u) + dx(v)) * (dy(u0) + dx(v0))
    )
    + int2d(Th)(
        penalty * (abs(x - supportPos) < supportTolerance) * (x >= 0.1*L) * (x <= 0.9*L) * v * v0
    )  // Penalty for intermediate support
    - int1d(Th, 3)(q * v0)  // Distributed load on top edge (label 3)
    + on(4, u=0, v=0)        // Fixed at left end (label 4)
    ;

// Solve
elasticity;

// Post-processing: Extract results
// Tip deflection: displacement at (L, h/2)
real tipDeflection = v(L, h/2);

// Compliance: C = 0.5 * ∫ σ:ε dV = 0.5 * ∫ F·u dS
// For distributed load: C = 0.5 * ∫ q * v dS (on top edge)
real compliance = 0.5 * int1d(Th, 3)(q * v);

// Max stress: von Mises stress
Ph sxx, syy, sxy;
sxx = lambda * (dx(u) + dy(v)) + 2 * mu * dx(u);
syy = lambda * (dx(u) + dy(v)) + 2 * mu * dy(v);
sxy = mu * (dy(u) + dx(v));

Ph vonMises = sqrt(sxx^2 + syy^2 - sxx*syy + 3*sxy^2);
real maxStress = vonMises[].max;

// Output results to file
ofstream results("freefem_results.txt");
results << "tip_deflection " << tipDeflection << endl;
results << "compliance " << compliance << endl;
results << "max_stress " << maxStress << endl;
results << "support_pos " << supportPos << endl;

// Also print to console for debugging
cout << "FreeFEM Results:" << endl;
cout << "  Support position: " << supportPos << " m" << endl;
cout << "  Tip deflection: " << tipDeflection << " m" << endl;
cout << "  Compliance: " << compliance << " J" << endl;
cout << "  Max von Mises stress: " << maxStress << " Pa" << endl;

